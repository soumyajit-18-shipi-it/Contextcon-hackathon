# Copy to .env and fill in. Never commit .env.
CRUSTDATA_API_KEY=
# LLM key (Member C picks the provider and adds the variable name here)
LLM_API_KEY=
# Optional: where the SQLite database lives (default: verity.db in the repo root)
VERITY_DB_PATH=verity.db
# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
